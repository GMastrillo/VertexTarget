# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy Supabase projects may use this name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
GOOGLE_GEMINI_API_KEY=your_gemini_key

# WhatsApp official Meta Cloud API (server-only)
WHATSAPP_META_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_META_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_META_APP_SECRET=your_meta_app_secret
WHATSAPP_META_VERIFY_TOKEN=your_webhook_verify_token

# WhatsApp non-official provider adapter (server-only)
WHATSAPP_UNOFFICIAL_BASE_URL=https://your-provider.example.com
WHATSAPP_UNOFFICIAL_API_KEY=your_provider_api_key
WHATSAPP_UNOFFICIAL_WEBHOOK_KEY=your_webhook_key
