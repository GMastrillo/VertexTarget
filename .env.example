# ==============================================================================
# VertexTarget & Vertex OS — Variáveis de Ambiente
# ==============================================================================

# URL da aplicação (usada para canonicals, sitemap, links de recuperação e redirects)
APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004

# ------------------------------------------------------------------------------
# Supabase (Banco de Dados & Autenticação)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legado: NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Chave com privilégios administrativos (EXCLUSIVAMENTE no servidor)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------------------------------------------
# Vertex OS — Segurança & Criptografia Interna (Servidor)
# ------------------------------------------------------------------------------
# Segredo HMAC para tokens de recuperação de senha com prova criptográfica
AUTH_RECOVERY_SECRET=generate_a_random_32_bytes_hex_secret_here

# Segredo HMAC para hash de IP anonimizado nas rotas públicas com rate limit
REQUEST_LIMIT_SECRET=generate_another_random_32_bytes_secret_here

# Proxy confiável para resolução de IP ('vercel', 'cloudflare', ou 'none')
TRUSTED_PROXY=none

# ------------------------------------------------------------------------------
# Anti-Abuso / Bot Protection (hCaptcha)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# ------------------------------------------------------------------------------
# Inteligência Artificial (Google Gemini via SDK oficial @google/genai)
# ------------------------------------------------------------------------------
# Chave da API do Google Gemini (EXCLUSIVAMENTE no servidor)
GEMINI_API_KEY=your_gemini_api_key
# Modelo padrão (opcional, padrão: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Freios globais de custo do Vertex OS (teto mensal coletivo)
OS_GLOBAL_COPY_LIMIT=1000
OS_GLOBAL_SEARCH_LIMIT=100

# ------------------------------------------------------------------------------
# Faturamento & Assinaturas (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# WhatsApp / Atendimento (Opcional)
# ------------------------------------------------------------------------------
# Número de atendimento exibido no site comercial
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# WhatsApp Meta Cloud API Oficial (servidor)
WHATSAPP_META_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_META_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_META_APP_SECRET=your_meta_app_secret
WHATSAPP_META_VERIFY_TOKEN=your_webhook_verify_token

# Provedor não-oficial / Gateway alternativo (servidor)
WHATSAPP_UNOFFICIAL_BASE_URL=https://your-provider.example.com
WHATSAPP_UNOFFICIAL_API_KEY=your_provider_api_key
WHATSAPP_UNOFFICIAL_WEBHOOK_KEY=your_webhook_key
